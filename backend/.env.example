# Database
DATABASE_URL=postgresql+asyncpg://dealfindio:dealfindio_dev@localhost:5432/dealfindio_dev
DATABASE_ECHO=False
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=0

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_SOCKET_KEEPALIVE=True

# Firebase
FIREBASE_PROJECT_ID=dealfindio-dev
FIREBASE_SERVICE_ACCOUNT_JSON=/path/to/firebase-sa-key.json

# Claude API (for Phase 2+)
ANTHROPIC_API_KEY=sk-ant-v0-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Environment & Logging
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json

# External APIs
OPEN_FOOD_FACTS_USER_AGENT=dealfindio/1.0 (contact@dealfindio.com.au)

# Monitoring (Optional)
SENTRY_DSN=
SLACK_WEBHOOK_URL=

# Security
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081

# API
API_V1_STR=/api/v1
PROJECT_NAME=dealfindio

# ─────────────────────────────────────────────────────────────────────
# Object storage (product images, receipts, catalog assets)
# Backend: 'local' (dev, no creds) | 'r2' (Cloudflare R2, $0 egress) | 's3'
# ─────────────────────────────────────────────────────────────────────
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_LOCAL_ROOT=/tmp/dealfindio-media
OBJECT_STORAGE_LOCAL_BASE_URL=/media
# For OBJECT_STORAGE_BACKEND=r2 (fill from the Cloudflare R2 dashboard):
# R2_ACCOUNT_ID=
# R2_BUCKET=dealfindio-media
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# R2_REGION=auto
# R2_PUBLIC_BASE_URL=https://images.dealfindio.com.au

# Open Food Facts image enrichment (Feature A)
OFT_ENRICH_ENABLED=True
OFT_SEARCH_MIN_DELAY_S=2.0
OFT_SEARCH_MAX_DELAY_S=5.0
OFT_ENRICH_LIMIT_PER_RUN=500

# ─────────────────────────────────────────────────────────────────────
# Authenticated full-catalog scraper (Feature B)
# Credentials live here ONLY — never stored in Redis/DB. Optional: browse
# may be anonymous. Full crawls are on-demand (admin panel); set a per-store
# 5-field cron to schedule DELTA crawls (empty = on-demand only).
# ─────────────────────────────────────────────────────────────────────
# COLES_EMAIL=
# COLES_PASSWORD=
CATALOG_MIN_DELAY_S=3.0
CATALOG_MAX_DELAY_S=8.0
CATALOG_BURST_LIMIT=5
CATALOG_PAGE_SIZE=48
CATALOG_MAX_PAGES_PER_CATEGORY=200
CATALOG_COLES_ENABLED=False
CATALOG_COLES_CRON=
# CATALOG_WOOLWORTHS_ENABLED=False
# CATALOG_WOOLWORTHS_CRON=
