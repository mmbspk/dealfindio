# mobile/.env.example — copy to .env.local (gitignored) and adjust for your machine
#
# iOS Simulator: localhost works out of the box (shares host network).
# Android Emulator: use http://10.0.2.2:8010
# Physical device on LAN: use your Mac's LAN IP, e.g. http://192.168.1.100:8010
# Staging/production: set to the actual API hostname.
#
# If this var is unset, the app defaults to http://localhost:8010 (iOS Simulator).

# EXPO_PUBLIC_API_URL=http://localhost:8010
